# Copy to .env and fill in placeholder values. Never commit .env.
# All values below are placeholders.

# GCP
GOOGLE_CLOUD_PROJECT=example-project-dev
BILLING_ACCOUNT_ID=012345-6789AB-CDEF01
BILLING_EXPORT_DATASET=example-project-billing.billing_export
BILLING_EXPORT_TABLE=gcp_billing_export_resource_v1_012345_6789AB_CDEF01
REGION=asia-south1

# Prometheus (used by detectors/k8s_rightsizing.py when not using --from-json)
PROMETHEUS_URL=http://prometheus.monitoring.svc.cluster.local:9090
PROMETHEUS_LOOKBACK=14d

# Cleanup defaults (cleanup/cleanup_orphaned_resources.sh)
CLEANUP_MIN_AGE_DAYS=30
CLEANUP_EXCLUDE_LABEL=keep=true
CLEANUP_LOG_DIR=./out

# Notifications (optional; leave blank to disable)
SLACK_WEBHOOK_URL=
